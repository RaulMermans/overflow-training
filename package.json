{
  "name": "workout-tracker-ios",
  "version": "1.0.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "ios:node20": "env PATH=\"/opt/homebrew/opt/node@20/bin:$PATH\" NODE_PATH= expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src __tests__ scripts --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:touched": "node ./scripts/lint-touched.mjs",
    "lint:no-new-debt": "node ./scripts/lint-no-new-debt.mjs",
    "lint:no-new-debt:baseline": "node ./scripts/lint-no-new-debt.mjs --write-baseline",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:verify:contract": "node ./scripts/verify-supabase-contract.mjs",
    "db:contract-audit": "supabase db execute --file scripts/db/contract_audit.sql",
    "db:smoke-test": "supabase db execute --file scripts/db/smoke-test-start-workout.sql",
    "db:test-routine-atomic": "supabase db execute --file scripts/db/test-upsert-routine-atomic.sql",
    "db:smoke-scheduled": "supabase db execute --file scripts/db/smoke-test-start-scheduled-workout.sql",
    "db:smoke-change-routine": "supabase db execute --file scripts/db/smoke-test-change-routine-after-complete.sql",
    "db:sanity-checks": "supabase db execute --file scripts/db/sanity_checks.sql",
    "db:progress-sanity": "supabase db execute --file scripts/db/progress-sanity-check.sql",
    "dev:progress-sanity": "tsx scripts/dev/progress-sanity-check.ts",
    "check:env": "node ./scripts/check-env.js",
    "check:env:local": "node ./scripts/check-env.js --mode=local",
    "check:env:ci": "node ./scripts/check-env.js --mode=ci",
    "check:env:release": "node ./scripts/check-env.js --mode=release",
    "check:node-modules-integrity": "node ./scripts/check-node-modules-integrity.mjs",
    "check:no-duplicate-suffix-files": "node ./scripts/check-no-duplicate-suffix-files.mjs",
    "check:governance": "node ./scripts/check-governance-drift.mjs",
    "verify:auth": "node ./scripts/verify-auth-contract.mjs",
    "verify:release-config": "node ./scripts/verify-release-config.mjs",
    "lint:no-hex": "bash ./scripts/check-no-hex.sh",
    "release:identity": "node scripts/print-release-identity.mjs",
    "preflight:beta": "npm run preflight:release",
    "preflight:release": "npm run check:node-modules-integrity && npm run check:no-duplicate-suffix-files && npm run check:env:release && npm run db:verify:contract && npm run verify:auth && npm run verify:release-config && npm run typecheck && npm test -- --runInBand && npm run lint:no-new-debt && npm run lint:no-hex && npm run release:identity",
    "e2e:create-user": "tsx e2e/helpers/auth.ts create",
    "e2e:cleanup": "tsx e2e/helpers/cleanup.ts"
  },
  "dependencies": {
    "@expo-google-fonts/rubik": "^0.4.2",
    "@sentry/react-native": "^6.15.0",
    "@shopify/restyle": "^2.4.5",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~54.0.32",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "^6.0.22",
    "expo-secure-store": "~15.0.5",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "lodash": "^4.17.23",
    "posthog-react-native": "^4.34.0",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendar-heatmap": "^0.2.4",
    "react-native-calendars": "^1.1314.0",
    "react-native-gifted-charts": "^1.4.73",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
