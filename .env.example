# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics (Optional — app works without these)
EXPO_PUBLIC_POSTHOG_KEY=phc_your_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Calendar Sync (set locally when testing Google Calendar or preparing a release build)
# Reuse the existing iOS OAuth 2.0 client ID for bundle id `com.workout-tracker.ios`.
# Do not create a new client for this activation path, and never put a client secret in the app.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
